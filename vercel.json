{
  "version": 2,
  "builds": [
    {
      "src": "API/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "Public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/API/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/Public/$1"
    }
  ]
}

